include LICENCE
include README.md
include pyproject.toml
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py *.json *.md
global-exclude *.py[cod]
global-exclude .env .env.*
global-exclude .coverage coverage.xml
global-exclude *~
prune build
prune dist
prune .release-audit
prune htmlcov
prune pytest-cache-files-*
include .env.example
